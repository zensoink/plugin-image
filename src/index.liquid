<!DOCTYPE html>
<html lang="{{ zenso.user.language | default: 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width={{ zenso.device.width | default: 800 }}, height={{ zenso.device.height | default: 480 }}, initial-scale=1.0">
    <link href="{{ 'favicon.ico' | asset_url }}" rel="icon" type="image/x-icon" />
    <title>{{ plugin.name }}</title>
</head>
<body class="{% if config.grayscale %}is-grayscale{% endif %}">
    {% if data.image.src %}
        <div class="image-wrapper">
            <img id="zenso-image" src="{{ data.image.src }}" alt="Display photo" class="fit-{{ config.fit | default: 'cover' }}" />
        </div>
    {% elsif data.image.empty_reason == 'fetch_failed' %}
        <div class="empty-state">
            <div class="empty-icon">⚠️</div>
            <h2>Unable to load image</h2>
            <p>Could not fetch image from the provided URL.</p>
            {% if config.url %}
                <p class="empty-url">{{ config.url }}</p>
            {% endif %}
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-icon">🖼️</div>
            <h2>No image configured</h2>
            <p>Enter an image URL in the plugin configuration settings.</p>
        </div>
    {% endif %}
</body>
</html>
